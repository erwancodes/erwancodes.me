---
export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Erwan Sagnardon",
      url: "https://www.erwancodes.me/about",
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Erwan Sagnardon",
      logo: {
        "@type": "ImageObject",
        url: "https://www.erwancodes.me/erwan-avatar.jpg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://www.erwancodes.me/erwan-avatar.jpg",
    articleSection: data.tags?.[0] || "Technology",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Erwan Sagnardon",
    url: "https://www.erwancodes.me",
    image: "https://www.erwancodes.me/erwan-avatar.jpg",
    sameAs: [
      "https://github.com/ErwanExplorer",
      "https://instagram.com/erwan.code",
      "https://www.linkedin.com/in/erwan-sagnardon/",
    ],
    jobTitle: "Student Developer",
    description:
      "Étudiant en BTS SIO passionné par la tech, l'IA et l'astronomie. Je crée des projets full-stack innovants et partage mon code sur GitHub.",
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Erwan Sagnardon",
    url: "https://www.erwancodes.me",
    description:
      "Étudiant en BTS SIO passionné par la tech, l'IA et l'astronomie. Je crée des projets full-stack innovants et partage mon code sur GitHub.",
    author: {
      "@type": "Person",
      name: "Erwan Sagnardon",
    },
    potentialAction: {
      "@type": "SearchAction",
      target: "https://www.erwancodes.me/search?q={search_term_string}",
      "query-input": "required name=search_term_string",
    },
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />